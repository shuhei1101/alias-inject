# 検査に使ったスクリプト
import subprocess, sys, yaml, glob
from pathlib import Path
from jsonschema import Draft202012Validator
from referencing import Registry, Resource
K, REF, ROOT = sys.argv[1], "design-schemas/v8.1.0", Path(sys.argv[2])
def show(p): return yaml.safe_load(subprocess.run(["git","-C",K,"show",f"{REF}:{p}"],capture_output=True,text=True,check=True).stdout)
cfg = yaml.safe_load((ROOT/"project-index.yaml").read_text(encoding="utf-8"))
total = 0
for d in cfg["documents"]:
    s = d["schema"]; path = s["path"]; base = str(Path(path).parent)
    files = sorted({f for pat in d["paths"] for f in glob.glob(str(ROOT/pat))} - {f for f in glob.glob(str(ROOT/"docs/**/*"),recursive=True) if Path(f).name in d.get("exclude",[]) and d.get("records")!="files" and Path(f).name=="index.yaml" and d["id"]!="index"})
    if d["id"]!="index": files=[f for f in files if Path(f).name!="index.yaml"]
    def retrieve(uri):
        return Resource.from_contents(show(f"{base}/{uri.split('#')[0]}"))
    reg = Registry(retrieve=retrieve)
    v = Draft202012Validator(show(path), registry=reg)
    for f in files:
        data = yaml.safe_load(Path(f).read_text(encoding="utf-8"))
        errs = list(v.iter_errors(data))
        total += len(errs)
        print(f"{d['id']}\t{Path(f).relative_to(ROOT)}\t{len(errs)}")
        for e in errs[:10]: print("   ", list(e.absolute_path), e.message[:200])
print("違反の合計:", total)

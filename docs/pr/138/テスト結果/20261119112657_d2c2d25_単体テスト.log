$ run_url=$(gh workflow run test.yml --ref "$(git branch --show-current)" | grep -o 'https://[^ ]*/actions/runs/[0-9]*') && run_id=${run_url##*/} && (n=0; until gh api "repos/{owner}/{repo}/actions/runs/$run_id?exclude_pull_requests=true" > /dev/null 2>&1; do n=$((n+1)); if [ $n -ge 10 ]; then echo "実行 $run_id を 10 秒参照できません" >&2; exit 1; fi; sleep 1; done) && (rc=0; gh run watch "$run_id" --exit-status > /dev/null || rc=1; gh run view "$run_id" --log; exit $rc)

# Red（実装の前）。fail は test_handle_turn_step_shows_added の 1 件で、quoteAnswer が showAdded を呼ばないため（実装が無いことによる）
# 実装の前から pass したテスト:
#   test_handle_turn_step_when_show_added_off・test_handle_turn_step_when_append_denied の「transcript の行が届かない」は、作業ブランチの hooks/handlers.ts の quoteAnswer が表示を呼ばない振る舞いによる（quoteAnswer を入れた commit: bbda831）


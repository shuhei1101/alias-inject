## 検査のスクリプト（$SCRIPT）

dev-docs の読み込みの関数を呼ぶ。設定のスキーマ・行の参照・ファイルの有無（_assemble）、文書の読み込み（DocumentStore.load）、各文書の Schema の検査・関連の種類・タグ（DocumentChecker.check）、ref の列の欠け（check_sync）を通し、違反が 1 件でもあれば終了コード 1 を返す。

```python
"""dev-docs の読み込みで、配信元の設定と各文書の検査の違反を数える。"""

from __future__ import annotations

import sys
import tempfile
from collections import Counter
from pathlib import Path

from dev_docs.features.access.types import Target
from dev_docs.features.documents.store import DocumentStore, check_sync
from dev_docs.features.history.snapshot import SnapshotStore
from dev_docs.features.sources.service import _assemble
from dev_docs.features.validation.service import DocumentChecker

CONFIG = Path(sys.argv[1]).resolve()
TIMEOUT_SEC = 30

# 設定をマージして、スキーマ・行の参照・ファイルの有無を確かめる
served, config, violations = _assemble([CONFIG], source_id=None, scope_read=[], scope_write=None)
print(f"設定: {CONFIG}")
print(f"設定のスキーマの違反: {len(violations)} 件")
for violation in violations:
    print(f"  {violation.path}: {violation.rule} {violation.fix}")
if served is None or config is None:
    sys.exit(1)

with tempfile.TemporaryDirectory() as state:
    store = DocumentStore(SnapshotStore(Path(state)))
    checker = DocumentChecker(store, TIMEOUT_SEC)
    target = Target(served, served.root, None, None, "read")
    result = store.load(target)
    print(f"読み込んだ文書: {len(result.documents)} 件（読めなかったファイル {len(result.problems)} 件）")
    for problem in result.problems:
        print(f"  {problem.path}: {problem.reason}: {problem.detail}")

    counts = Counter(document.kind for document in result.documents)
    for table in config.documents:
        print(f"  {table.id}: {counts.get(table.id, 0)} 件")

    # 1 つのファイルが 2 つの行に載っていないか
    owners: dict[str, list[str]] = {}
    for document in result.documents:
        owners.setdefault(document.path, []).append(document.kind)
    duplicated = {path: kinds for path, kinds in owners.items() if len(kinds) > 1}
    print(f"2 つ以上の行に載ったファイル: {len(duplicated)} 件")
    for path, kinds in duplicated.items():
        print(f"  {path}: {kinds}")

    # 各文書に、スキーマ・関連の種類・タグの検査を通す
    total = 0
    for document in result.documents:
        found = checker.check(target, document, on="read")
        total += len(found)
        for violation in found:
            print(f"  {document.path}: {violation.path}: {violation.rule} {violation.fix}")
    print(f"文書の検査の違反: {total} 件")

    report = check_sync(store, served)
    print(f"ref の列の欠け: {len(report.missing_refs)} 件")
    for line in report.missing_refs:
        print(f"  {line}")

    print()
    print("文書の名前とタグ:")
    for document in sorted(result.documents, key=lambda item: (item.kind, item.path)):
        print(
            f"  [{document.kind}] {document.path} | {document.metadata.get('name')}"
            f" | {document.metadata.get('tags')}"
        )

    failed = bool(violations or result.problems or duplicated or total)
    sys.exit(1 if failed else 0)
```

